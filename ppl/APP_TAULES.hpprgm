// ===================================================================
// TAULES  -  programa de l'App  (HP Prime G2)
//
// Aixo NO es un programa del Program Catalog: es el programa intern de
// l'app en blanc anomenada TAULES. Es crea des de la calculadora amb
//    [Apps] -> tecla (Save) -> Base App: None -> nom: TAULES
// i despres s'hi enganxa aquest text.
//
// L'app nomes es un llancador: el motor (TERMOLIB) i la interficie
// (TERMO) segueixen sent programes globals, i les seves funcions
// exportades es veuen des d'aqui. Per aixo l'app es diu TAULES i no
// TERMO: dos simbols globals amb el mateix nom xocarien.
//
// Guany real: obrir-la son 2 pulsacions ([Apps] + tocar la icona) en
// comptes de [Shift][Program] + navegar + [Enter].
// ===================================================================

// S'executa en engegar l'app: entra directe al formulari.
EXPORT START()
BEGIN
  TERMO();
END;

// La tecla [Num] tambe hi entra: es la mes gran i facil de trobar.
EXPORT Num()
BEGIN
  TERMO();
END;

// [Shift][Apps] mostra aquesta nota. Info() nomes admet PRINT.
EXPORT Info()
BEGIN
  LOCAL zi;
  // Recorre la MATEIXA llista que dibuixa [Help], per no tenir dos textos
  // d'ajuda que se separin amb el temps. Info() nomes admet PRINT.
  PRINT();
  PRINT("TAULES - propietats termodinamiques");
  PRINT("");
  FOR zi FROM 1 TO SIZE(TAJUT) DO
    PRINT(TAJUT(zi));
  END;
END;

// Torna a deixar-ho tot com al principi.
EXPORT RESET()
BEGIN
  TCUR := 1;
  TD1 := 1;
  TD2 := 6;
  TV1 := 0;
  TV2 := 0;
  TS1 := {};
  TS2 := {};
  TLOAD(TCUR);
END;

// No hi ha blocs VIEW a proposit. START() engega TERMO(), que es queda amb
// el teclat mentre dura, aixi que les tecles de vista no arriben mai a
// l'app: es TERMO qui les llegeix a la pantalla de resultats (qualsevol
// tecla torna al formulari, [View] obre el menu, [Help] l'ajuda, [Esc] surt).
