// TAULES (App) - motor + interficie
// GENERADO por tools/gen_merged.py -- NO EDITAR A MANO.
// Se regenera desde data/master.json y los fuentes de ppl/.
// ===================================================================

// ============ MOTOR (ve de ppl/TERMOLIB.hpprgm) ============
EXPORT TST, TSP, TIX, TIS, TMD;

// UNA declaracio per linia i sempre en majuscules.
// PPL admet 'EXPORT A,B,C;' (sense valor) o 'EXPORT A:=v;' (una sola), pero
// NO 'EXPORT A:=1, B:=2;': aixo dona error de sintaxi. I els noms en
// minuscula poden xocar amb variables predefinides de Home.
EXPORT TCUR:=1;       // index de la substancia activa dins TSUBS
EXPORT TERR:="";      // text de l'ultim error
EXPORT TS1:={};       // estats desats (proces 1 -> 2). Han de nomes
EXPORT TS2:={};       // com a LLISTA: si es declaren numero, TS2(5) es llegeix
                      // com una crida a funcio i no compila.

// camps del formulari. TD1/TD2 son l'index de magnitud triat als
// desplegables (1=P 2=T 3=x 4=v 5=u 6=h 7=s) i TV1/TV2 el seu valor.
// Son globals a proposit: aixi la pantalla recorda l'ultima combinacio.
EXPORT TD1:=1;
EXPORT TD2:=6;
EXPORT TV1:=0;
EXPORT TV2:=0;
// Llista FIXA dels desplegables. Porta les DUES unitats de temperatura a
// proposit: INPUT construeix les etiquetes una sola vegada, aixi que si la
// unitat depengues de la substancia no es podria refrescar en canviar-la
// dins del formulari. Oferint totes dues, l'etiqueta no ha de canviar mai i
// es la calculadora qui converteix (TCONV).
//   1 P | 2 T[C] | 3 T[K] | 4 x | 5 v | 6 u | 7 h | 8 s
EXPORT TPROP:={"P [MPa]","T [C]","T [K]","x",
               "v [m3/kg]","u [kJ/kg]","h [kJ/kg]","s [kJ/kgK]"};

// -------------------------------------------------------------------
// utilitats numeriques
// -------------------------------------------------------------------
EXPORT TLIN(zxv, zxa, zxb, zya, zyb)
BEGIN
  IF zxb == zxa THEN RETURN zya; END;
  RETURN zya + (zxv - zxa) * (zyb - zya) / (zxb - zxa);
END;

// Cerca el tram [i, i+1] de la columna c que conte x, dins de les files
// r0..r0+n-1. Retorna 0 si x cau fora del rang tabulat: mai s'extrapola.
EXPORT TBRK(zm, zc, zx, zrbase, zn)
BEGIN
  LOCAL zlo, zhi, zmid;
  IF zn < 2 THEN RETURN 0; END;
  IF zx < zm(zrbase, zc) - 1E-9 THEN RETURN 0; END;
  IF zx > zm(zrbase + zn - 1, zc) + 1E-9 THEN RETURN 0; END;
  zlo := zrbase; zhi := zrbase + zn - 1;
  WHILE zhi - zlo > 1 DO
    zmid := IP((zlo + zhi) / 2);
    IF zm(zmid, zc) <= zx THEN zlo := zmid; ELSE zhi := zmid; END;
  END;
  RETURN zlo;
END;

// -------------------------------------------------------------------
// carrega de substancia
// -------------------------------------------------------------------
EXPORT TLOAD(zii)
BEGIN
  LOCAL zp;
  IF zii < 1 OR zii > SIZE(TSUBS) THEN RETURN 0; END;
  zp := TSUBS(zii);
  TST := EXPR(zp + "ST");
  TSP := EXPR(zp + "SP");
  TIX := EXPR(zp + "IX");
  TIS := EXPR(zp + "IS");
  TMD := EXPR(zp + "MD");
  TCUR := zii;
  RETURN 1;
END;

// Index del desplegable -> id intern de magnitud (1=P 2=T 3=x 4=v 5=u 6=h 7=s).
// Les dues entrades de temperatura cauen totes dues al 2.
EXPORT TIDX(zd)
BEGIN
  IF zd <= 2 THEN RETURN zd; END;
  IF zd == 3 THEN RETURN 2; END;
  RETURN zd - 1;
END;

// Passa el valor a la unitat en que esta tabulada la substancia. La resta de
// magnituds no es toquen: nomes la temperatura canvia d'unitat entre taules.
EXPORT TCONV(zd, zv)
BEGIN
  IF zd == 2 AND TMD(2) == 1 THEN RETURN zv + 273.15; END;
  IF zd == 3 AND TMD(2) == 0 THEN RETURN zv - 273.15; END;
  RETURN zv;
END;

// Temperatura de la taula passada a Kelvin, per ensenyar-la sempre a totes
// dues escales.
EXPORT TTOK(zt)
BEGIN
  IF TMD(2) == 1 THEN RETURN zt; END;
  RETURN zt + 273.15;
END;

// -------------------------------------------------------------------
// corba de saturacio
// -------------------------------------------------------------------
// Retorna {Pl, Pv, vl, vv, ul, uv, hl, hv, sl, sv} interpolat a T.
EXPORT TSATT(zt)
BEGIN
  LOCAL zii, zn, zk, zr, zf, zd;
  zd := DIM(TST); zn := zd(1);
  zii := TBRK(TST, 1, zt, 1, zn);
  IF zii == 0 THEN TERR := "T fora de rang (saturacio)"; RETURN {}; END;
  zf := TLIN(zt, TST(zii,1), TST(zii+1,1), 0, 1);
  zr := {};
  FOR zk FROM 2 TO 11 DO
    zr(zk-1) := TST(zii,zk) + zf * (TST(zii+1,zk) - TST(zii,zk));
  END;
  RETURN zr;
END;

// Retorna {Tl, Tv, vl, vv, ul, uv, hl, hv, sl, sv} interpolat a P.
// S'usa aquesta taula, i no la de T, sempre que la dada sigui P:
// reconstruir T_sat(P) des de la taula per T dona fins a 0,3 C d'error
// perque P_sat(T) es exponencial.
EXPORT TSATP(zp)
BEGIN
  LOCAL zii, zn, zk, zr, zf, zd;
  zd := DIM(TSP); zn := zd(1);
  zii := TBRK(TSP, 1, zp, 1, zn);
  IF zii == 0 THEN TERR := "P fora de rang (saturacio)"; RETURN {}; END;
  zf := TLIN(zp, TSP(zii,1), TSP(zii+1,1), 0, 1);
  zr := {};
  FOR zk FROM 2 TO 11 DO
    zr(zk-1) := TSP(zii,zk) + zf * (TSP(zii+1,zk) - TSP(zii,zk));
  END;
  RETURN zr;
END;

// -------------------------------------------------------------------
// isobares
// -------------------------------------------------------------------
// Interpola dins de la isobara k a la temperatura T, a la branca ph
// (0 = liquid, 1 = vapor). Retorna {v,u,h,s} o {} si T no hi cau.
// Cada isobara porta liquid subrefredat, el salt de saturacio i vapor
// sobreescalfat; TIX(k,4) diu quantes files son de la branca liquida.
EXPORT TISOT(zk, zt, zph)
BEGIN
  LOCAL zrbase, znn, znl, zii, zf, zres;
  LOCAL zj;
  zrbase := TIX(zk,2); znn := TIX(zk,3); znl := TIX(zk,4);
  IF zph == 0 THEN
    IF znl < 2 THEN RETURN {}; END;
    zii := TBRK(TIS, 1, zt, zrbase, znl);
  ELSE
    IF znn - znl < 2 THEN RETURN {}; END;
    zii := TBRK(TIS, 1, zt, zrbase + znl, znn - znl);
  END;
  IF zii == 0 THEN RETURN {}; END;
  zf := TLIN(zt, TIS(zii,1), TIS(zii+1,1), 0, 1);
  zres := {};
  FOR zj FROM 2 TO 5 DO
    zres(zj-1) := TIS(zii,zj) + zf * (TIS(zii+1,zj) - TIS(zii,zj));
  END;
  RETURN zres;
END;

// Doble interpolacio: primer en T dins de cada isobara, despres en P.
// Aquest ordre es el que es fa a ma a classe, i es respecta perque el
// resultat coincideixi amb la solucio oficial.
//
// Cas espinos: a la temperatura T, una de les dues isobares veines pot
// estar a l'ALTRA fase (a P1 < P la saturacio arriba abans, aixi que un
// liquid comprimit a P pot ser vapor a P1). Interpolar entre un liquid i
// un vapor donaria un numero sense sentit. Quan passa, s'agafa el propi
// estat de saturacio a la mateixa T com a punt de suport i s'avisa.
EXPORT TSPH(zp, zt, zph)
BEGIN
  LOCAL zm, zk, za, zb, zra, zrb;
  LOCAL zres, zj, zsa, zpsat, zrsat, zd;
  LOCAL zhit;
  zd := DIM(TIX); zm := zd(1);
  TERR := "";
  // Isobara exactament tabulada. Es marca amb una bandera i es surt amb
  // BREAK: PPL no admet RETURN des de dins d'un FOR.
  zhit := 0;
  FOR zk FROM 1 TO zm DO
    IF ABS(TIX(zk,1) - zp) < 1E-12 THEN
      zhit := zk;
      BREAK;
    END;
  END;
  IF zhit > 0 THEN
    zres := TISOT(zhit, zt, zph);
    IF SIZE(zres) == 0 THEN TERR := "T fora de rang a aquesta P"; END;
    RETURN zres;
  END;
  zk := TBRK(TIX, 1, zp, 1, zm);
  IF zk == 0 THEN TERR := "P fora de rang (isobares)"; RETURN {}; END;
  za := TIX(zk,1); zb := TIX(zk+1,1);
  zra := TISOT(zk, zt, zph);
  zrb := TISOT(zk+1, zt, zph);

  IF SIZE(zra) == 4 AND SIZE(zrb) == 4 THEN
    zres := {};
    FOR zj FROM 1 TO 4 DO
      zres(zj) := TLIN(zp, za, zb, zra(zj), zrb(zj));
    END;
    RETURN zres;
  END;

  // una veina no te aquesta fase a aquesta T -> frontera de saturacio
  zsa := TSATT(zt);
  IF SIZE(zsa) == 0 THEN RETURN {}; END;
  TERR := "veina en altra fase: s'usa saturacio";
  IF zph == 0 THEN
    zpsat := zsa(1);
    zrsat := {zsa(3), zsa(5), zsa(7), zsa(9)};
  ELSE
    zpsat := zsa(2);
    zrsat := {zsa(4), zsa(6), zsa(8), zsa(10)};
  END;
  IF SIZE(zra) == 4 THEN
    zres := {};
    FOR zj FROM 1 TO 4 DO zres(zj) := TLIN(zp, za, zpsat, zra(zj), zrsat(zj)); END;
    RETURN zres;
  END;
  IF SIZE(zrb) == 4 THEN
    zres := {};
    FOR zj FROM 1 TO 4 DO zres(zj) := TLIN(zp, zb, zpsat, zrb(zj), zrsat(zj)); END;
    RETURN zres;
  END;
  TERR := "cap isobara veina te aquesta fase a aquesta T";
  RETURN {};
END;

// -------------------------------------------------------------------
// estats
// -------------------------------------------------------------------
// (P, T)
EXPORT TPT(zp, zt)
BEGIN
  LOCAL zsa, zreg, zr, zav;
  TERR := "";
  zsa := TSATP(zp);
  IF SIZE(zsa) == 0 THEN RETURN {0,0,0,0,0,0,0,-1,TERR}; END;
  IF zt < zsa(1) - 1E-9 THEN zreg := 0;
  ELSE IF zt > zsa(2) + 1E-9 THEN zreg := 2;
  ELSE
    // just a la saturacio: (P,T) no determina l'estat, cal x
    RETURN {zt, zp, zsa(3), zsa(5), zsa(7), zsa(9), 0, 1,
            "(P,T) satura: x indeterminat, s'agafa x=0"};
  END; END;
  zr := TSPH(zp, zt, IFTE(zreg == 0, 0, 1));
  zav := TERR;
  IF SIZE(zr) == 0 THEN RETURN {0,0,0,0,0,0,0,-1,TERR}; END;
  RETURN {zt, zp, zr(1), zr(2), zr(3), zr(4), -1, zreg, zav};
END;

// (P, x)
EXPORT TPX(zp, zx)
BEGIN
  LOCAL zsa, zt;
  TERR := "";
  IF zx < 0 OR zx > 1 THEN RETURN {0,0,0,0,0,0,0,-1,"x ha d'estar entre 0 i 1"}; END;
  zsa := TSATP(zp);
  IF SIZE(zsa) == 0 THEN RETURN {0,0,0,0,0,0,0,-1,TERR}; END;
  zt := zsa(1) + zx * (zsa(2) - zsa(1));
  RETURN {zt, zp,
          zsa(3) + zx*(zsa(4)-zsa(3)), zsa(5) + zx*(zsa(6)-zsa(5)),
          zsa(7) + zx*(zsa(8)-zsa(7)), zsa(9) + zx*(zsa(10)-zsa(9)),
          zx, 1, IFTE(TMD(3) == 1, "mescla: T bombolla/rosada", "")};
END;

// (T, x)
EXPORT TTX(zt, zx)
BEGIN
  LOCAL zsa, zp;
  TERR := "";
  IF zx < 0 OR zx > 1 THEN RETURN {0,0,0,0,0,0,0,-1,"x ha d'estar entre 0 i 1"}; END;
  zsa := TSATT(zt);
  IF SIZE(zsa) == 0 THEN RETURN {0,0,0,0,0,0,0,-1,TERR}; END;
  zp := zsa(1) + zx * (zsa(2) - zsa(1));
  RETURN {zt, zp,
          zsa(3) + zx*(zsa(4)-zsa(3)), zsa(5) + zx*(zsa(6)-zsa(5)),
          zsa(7) + zx*(zsa(8)-zsa(7)), zsa(9) + zx*(zsa(10)-zsa(9)),
          zx, 1, ""};
END;

// (P, propietat) amb pr = 1:v  2:u  3:h  4:s
// Encaminament: es compara y amb y_f(P) i y_g(P) de la taula de saturacio.
//   y < y_f          -> liquid comprimit   -> inversa dins de la isobara
//   y_f <= y <= y_g  -> bifasic            -> x = (y-y_f)/(y_g-y_f), directe
//   y > y_g          -> vapor sobreescalfat-> inversa dins de la isobara
EXPORT TPY(zp, zpr, zy)
BEGIN
  LOCAL zsa, zyf, zyg, zx, zt, zr;
  LOCAL zreg, zav;
  TERR := "";
  zsa := TSATP(zp);
  IF SIZE(zsa) == 0 THEN RETURN {0,0,0,0,0,0,0,-1,TERR}; END;
  zyf := zsa(1 + 2*zpr); zyg := zsa(2 + 2*zpr);
  IF zy >= zyf AND zy <= zyg THEN
    IF zyg == zyf THEN zx := 0; ELSE zx := (zy - zyf) / (zyg - zyf); END;
    RETURN TPX(zp, zx);
  END;
  IF zy < zyf THEN zreg := 0; ELSE zreg := 2; END;
  zt := TINVP(zp, zpr, zy, zreg);
  IF TERR <> "" AND zt == -99999 THEN RETURN {0,0,0,0,0,0,0,-1,TERR}; END;
  zr := TSPH(zp, zt, IFTE(zreg == 0, 0, 1));
  zav := TERR;
  IF SIZE(zr) == 0 THEN RETURN {0,0,0,0,0,0,0,-1,TERR}; END;
  RETURN {zt, zp, zr(1), zr(2), zr(3), zr(4), -1, zreg, zav};
END;

// Cerca inversa: donat (P, y) troba T a la regio monofasica.
// S'inverteix la MATEIXA funcio que fa el calcul directe (doble
// interpolacio) per biseccio, aixi anada i tornada son coherents.
// La monotonia de h i s amb T a P constant garanteix solucio unica.
EXPORT TINVP(zp, zpr, zy, zreg)
BEGIN
  LOCAL zm, zk, zkaa, zkbb, zkk, zph;
  LOCAL zlo, zhi, zii, zrr, zflo, zfhi;
  LOCAL zmid, zfm, zit, zd;
  zph := IFTE(zreg == 0, 0, 1);
  zd := DIM(TIX); zm := zd(1);
  // Se acota con LAS MISMAS isobaras que usara el calculo directo (las que
  // encierran P, o la exacta si esta tabulada). Usar mas isobaras estrecharia
  // el intervalo de busqueda de forma artificial y podria dejar fuera la
  // solucion.
  zkaa := 0;
  FOR zk FROM 1 TO zm DO
    IF ABS(TIX(zk,1) - zp) < 1E-12 THEN zkaa := zk; zkbb := zk; END;
  END;
  IF zkaa == 0 THEN
    zkaa := TBRK(TIX, 1, zp, 1, zm);
    IF zkaa == 0 THEN TERR := "P fora de rang (isobares)"; RETURN -99999; END;
    zkbb := zkaa + 1;
  END;
  zlo := -1E12; zhi := 1E12;
  FOR zkk FROM zkaa TO zkbb DO
    zii := TIX(zkk,2);
    IF zph == 0 THEN
      IF TIX(zkk,4) >= 2 THEN
        zlo := MAX(zlo, TIS(zii,1));
        zhi := MIN(zhi, TIS(zii + TIX(zkk,4) - 1, 1));
      END;
    ELSE
      IF TIX(zkk,3) - TIX(zkk,4) >= 2 THEN
        zlo := MAX(zlo, TIS(zii + TIX(zkk,4), 1));
        zhi := MIN(zhi, TIS(zii + TIX(zkk,3) - 1, 1));
      END;
    END;
  END;
  IF zlo >= zhi THEN TERR := "sense dades d'aquesta fase a aquesta P"; RETURN -99999; END;
  zrr := TSPH(zp, zlo, zph); IF SIZE(zrr) == 0 THEN TERR := "inversa: extrem invalid"; RETURN -99999; END;
  zflo := zrr(zpr) - zy;
  zrr := TSPH(zp, zhi, zph); IF SIZE(zrr) == 0 THEN TERR := "inversa: extrem invalid"; RETURN -99999; END;
  zfhi := zrr(zpr) - zy;
  IF zflo * zfhi > 0 THEN
    TERR := "valor fora del rang tabulat a aquesta P";
    RETURN -99999;
  END;
  FOR zit FROM 1 TO 60 DO
    zmid := (zlo + zhi) / 2;
    zrr := TSPH(zp, zmid, zph);
    IF SIZE(zrr) == 0 THEN BREAK; END;
    zfm := zrr(zpr) - zy;
    IF zflo * zfm <= 0 THEN zhi := zmid; zfhi := zfm; ELSE zlo := zmid; zflo := zfm; END;
    IF zhi - zlo < 1E-9 THEN BREAK; END;
  END;
  TERR := "";
  RETURN (zlo + zhi) / 2;
END;

// (T, propietat)
EXPORT TTY(zt, zpr, zy)
BEGIN
  LOCAL zsa, zyf, zyg, zx, zp, zr;
  LOCAL zreg, zav, zm, zk, zylo, zyhi;
  LOCAL zplo, zphi, zrr, zgot, zd, zout;
  TERR := "";
  zsa := TSATT(zt);
  IF SIZE(zsa) == 0 THEN RETURN {0,0,0,0,0,0,0,-1,TERR}; END;
  zyf := zsa(1 + 2*zpr); zyg := zsa(2 + 2*zpr);
  IF zy >= zyf AND zy <= zyg THEN
    IF zyg == zyf THEN zx := 0; ELSE zx := (zy - zyf) / (zyg - zyf); END;
    RETURN TTX(zt, zx);
  END;
  IF zy < zyf THEN zreg := 0; ELSE zreg := 2; END;
  // es recorren les isobares que tenen aquesta fase a aquesta T i es
  // busca el tram de P on y canvia de banda
  // El resultat s'acumula a zout i es retorna DESPRES del bucle: PPL no
  // admet RETURN des de dins d'un FOR.
  zd := DIM(TIX); zm := zd(1); zgot := 0; zplo := 0; zylo := 0;
  zout := {};
  FOR zk FROM 1 TO zm DO
    zrr := TISOT(zk, zt, IFTE(zreg == 0, 0, 1));
    IF SIZE(zrr) == 4 THEN
      zphi := TIX(zk,1); zyhi := zrr(zpr);
      IF zgot == 1 THEN
        IF (zylo - zy) * (zyhi - zy) <= 0 THEN
          zp := TLIN(zy, zylo, zyhi, zplo, zphi);
          zr := TSPH(zp, zt, IFTE(zreg == 0, 0, 1));
          zav := TERR;
          IF SIZE(zr) == 0 THEN
            zout := {0,0,0,0,0,0,0,-1,TERR};
          ELSE
            zout := {zt, zp, zr(1), zr(2), zr(3), zr(4), -1, zreg, zav};
          END;
          BREAK;
        END;
      END;
      zplo := zphi; zylo := zyhi; zgot := 1;
    END;
  END;
  IF SIZE(zout) == 9 THEN RETURN zout; END;
  RETURN {0,0,0,0,0,0,0,-1,"valor fora del rang tabulat a aquesta T"};
END;

// ========= INTERFICIE (ve de ppl/TERMO.hpprgm) =========
EXPORT TKHELP:=3;
EXPORT TKESC:=4;
EXPORT TKVIEW:=9;

EXPORT TSIG(zx, zn)
BEGIN
  LOCAL zex, zd;
  IF zx == 0 THEN RETURN "0"; END;
  zex := FLOOR(LOG(ABS(zx)));
  zd := zn - 1 - zex;
  IF zd < 0 THEN zd := 0; END;
  IF zd > 9 THEN zd := 9; END;
  RETURN STRING(ROUND(zx, zd));
END;

EXPORT TDEC(zx, zn)
BEGIN
  RETURN STRING(ROUND(zx, zn));
END;

// Espera una tecla de veritat, i la consumeix.
//
// No es fa servir WAIT(-1): no espera. Abans semblava que si perque en
// acabar el programa la pantalla es quedava dibuixada fins que es premia
// alguna cosa; en posar el bucle, els resultats passaven de llarg i tornava
// el formulari a l'instant.
//
// GETKEY torna el codi de l'ultima tecla premuda, o un valor negatiu si no
// n'hi ha cap pendent. Primer es buida el buffer (la tecla amb que s'ha
// acceptat el formulari encara hi es) i despres s'espera una de nova.
EXPORT TPAUSE()
BEGIN
  LOCAL zk;
  REPEAT
    zk := GETKEY;
  UNTIL zk < 0;
  REPEAT
    zk := GETKEY;
  UNTIL zk >= 0;
  RETURN zk;
END;

// ---- pantalla de resultats ----------------------------------------
EXPORT TSHOW(zst)
BEGIN
  LOCAL zy, zreg, zut, zsa;
  RECT();
  IF zst(8) < 0 THEN
    TEXTOUT_P("ERROR", 4, 4, 4, RGB(200,0,0));
    TEXTOUT_P(zst(9), 4, 34, 3);
    TEXTOUT_P("Cap valor: revisa dades o rang.", 4, 64, 2);
    TEXTOUT_P("Prem una tecla per continuar", 4, 210, 2);
    RETURN TPAUSE();
  END;
  zut := IFTE(TMD(2) == 1, " K", " C");
  // El motor marca tota la campana com a bifasica, tambe als extrems. Es
  // correcte per al calcul, pero en pantalla x=0 i x=1 son les fronteres i
  // convé dir-ho amb aquest nom: si no, un vapor saturat surt com "bifasic".
  zreg := "VAPOR SOBREESCALFAT";
  IF zst(8) == 0 THEN zreg := "LIQUID COMPRIMIT"; END;
  IF zst(8) == 1 THEN zreg := "BIFASIC"; END;
  IF zst(8) == 1 AND zst(7) <= 1E-9 THEN zreg := "LIQUID SATURAT  x=0"; END;
  IF zst(8) == 1 AND zst(7) >= 1 - 1E-9 THEN zreg := "VAPOR SATURAT  x=1"; END;
  TEXTOUT_P(TMD(1), 4, 2, 3);
  TEXTOUT_P(zreg, 4, 24, 3, RGB(0,0,180));
  // La T es dona SEMPRE a les dues escales: aixi tant se val en quina
  // estigui tabulada la substancia i no cal recordar-ho.
  zy := 45;
  IF TMD(2) == 1 THEN
    TEXTOUT_P("T = " + TDEC(zst(1),2) + " K = " + TDEC(zst(1)-273.15,2) + " C",
              4, zy, 3);
  ELSE
    TEXTOUT_P("T = " + TDEC(zst(1),2) + " C = " + TDEC(TTOK(zst(1)),2) + " K",
              4, zy, 3);
  END;
  zy := zy + 21;
  TEXTOUT_P("P = " + TSIG(zst(2),5) + " MPa", 4, zy, 3);
  zy := zy + 21;
  TEXTOUT_P("v = " + TSIG(zst(3),6) + " m3/kg", 4, zy, 3);
  zy := zy + 21;
  TEXTOUT_P("u = " + TDEC(zst(4),2) + " kJ/kg", 4, zy, 3);
  zy := zy + 21;
  TEXTOUT_P("h = " + TDEC(zst(5),2) + " kJ/kg", 4, zy, 3);
  zy := zy + 21;
  TEXTOUT_P("s = " + TDEC(zst(6),4) + " kJ/kgK", 4, zy, 3);
  zy := zy + 21;
  IF zst(7) >= 0 THEN
    TEXTOUT_P("x = " + TDEC(zst(7),4), 4, zy, 3, RGB(0,120,0));
  ELSE
    TEXTOUT_P("x = --", 4, zy, 3);
  END;
  // Context de saturacio: quanta T separa l'estat de la campana. D'un cop
  // d'ull es veu si s'esta a prop de la frontera, que es on cal anar amb
  // compte i on la interpolacio es mes delicada.
  IF zst(8) <> 1 THEN
    zsa := TSATP(zst(2));
    IF SIZE(zsa) == 10 THEN
      IF zst(8) == 2 THEN
        TEXTOUT_P("Tsat = " + TDEC(zsa(2),2) + zut + "   sobreescalfament +"
                  + TDEC(zst(1)-zsa(2),1), 4, 191, 2, RGB(0,110,0));
      ELSE
        TEXTOUT_P("Tsat = " + TDEC(zsa(1),2) + zut + "   subrefredament -"
                  + TDEC(zsa(1)-zst(1),1), 4, 191, 2, RGB(0,110,0));
      END;
    END;
  END;
  IF zst(9) <> "" THEN
    TEXTOUT_P("! " + zst(9), 4, 207, 2, RGB(200,80,0));
  END;
  TEXTOUT_P("tecla=formulari  View=menu  Help=ajuda  Esc=surt", 4, 224, 2);
  RETURN TPAUSE();
END;

// ---- ajuda ---------------------------------------------------------
// El text viu NOMES aqui. El dibuixa TAJUDA() amb [Help] i el imprimeix
// Info() de l'app amb [Shift][Apps], recorrent aquesta mateixa llista: aixi
// els dos diuen exactament el mateix i no poden anar cadascun pel seu cantó.
//
// Son 11 linies a proposit: amb interlineat de 17 px des de y=26, l'ultima
// cau a 196 i el peu a 218. Afegir-ne mes les solaparia.
EXPORT TAJUT:={
  "TEMPERATURA",
  "Hi ha T [C] i T [K] al desplegable: tria",
  "la que tinguis. Els resultats donen les dues.",
  "SALT ENTRE ESTATS",
  "Es recorden els DOS ultims calculs:",
  "l'anterior es l'estat 1, el nou el 2.",
  "El menu -> Salt 1->2 resta 2 menys 1 i dona",
  "dh, du, ds, dv. Calcula primer l'inicial:",
  "l'ordre decideix el signe.",
  "TECLES:  tecla=formulari   View=menu",
  "         Help=ajuda        Esc=surt"
};

EXPORT TAJUDA()
BEGIN
  LOCAL zy, zi;
  RECT();
  TEXTOUT_P("TAULES - ajuda", 4, 2, 3, RGB(0,0,180));
  zy := 26;
  FOR zi FROM 1 TO SIZE(TAJUT) DO
    TEXTOUT_P(TAJUT(zi), 4, zy, 2);
    zy := zy + 17;
  END;
  TEXTOUT_P("Prem una tecla per tornar", 4, 218, 2);
  TPAUSE();
  RETURN 1;
END;

// Diagnostic: diu el codi de la tecla que premis. Nomes els codis 30
// (Enter) i els de les fletxes estan documentats; si cal lligar una altra
// tecla a alguna cosa, aquest programa dona el numero.
EXPORT TKEY()
BEGIN
  LOCAL zk;
  RECT();
  TEXTOUT_P("Prem una tecla...", 4, 40, 3);
  zk := TPAUSE();
  RECT();
  TEXTOUT_P("codi = " + STRING(zk), 4, 40, 4, RGB(0,0,180));
  TEXTOUT_P("Prem una tecla per tornar", 4, 224, 2);
  TPAUSE();
  RETURN zk;
END;

// ---- programa principal -------------------------------------------
// La navegacio va DINS de la pantalla, no per les tecles de vista.
//
// Motiu: una app en blanc no te cap vista on reposar. Si START() torna, la
// calculadora cau a Home i llavors [Num] i [View] ja no arriben a l'app.
// I si START() no torna (bucle), es queda el teclat i aquelles tecles
// tampoc responen. Les dues coses no poden anar alhora, aixi que el menu
// es dibuixa i punt: sempre es veu que es pot fer.
EXPORT TERMO()
BEGIN
  LOCAL zok, zi1, zi2, zw1, zw2, zsw;
  LOCAL zst, zgo, zprev, zopt, zk;

  IF TCUR < 1 OR TCUR > SIZE(TSUBS) THEN TCUR := 1; END;
  IF TD1 < 1 OR TD1 > 8 THEN TD1 := 1; END;
  IF TD2 < 1 OR TD2 > 8 THEN TD2 := 7; END;   // per defecte (P, h)

  zgo := 1;
  zst := {0,0,0,0,0,0,0,-1,""};

  WHILE zgo == 1 DO
    zprev := TCUR;
    TLOAD(TCUR);

    // Camps de tipus real [0]: s'hi escriu el numero directament, sense
    // cometes. Els desplegables porten la unitat de cada magnitud.
    // Posicio {x%, ample%, fila}: l'etiqueta va al buit de l'ESQUERRA del
    // camp, per aixo x=22 i no 5 (amb 5 sortien retallades com un punt).
    zok := INPUT(
      { {TCUR, TNAMS, {22, 72, 0}},
        {TD1, TPROP, {22, 30, 1}}, {TV1, [0], {58, 37, 1}},
        {TD2, TPROP, {22, 30, 2}}, {TV2, [0], {58, 37, 2}} },
      "TERMO - quines dues coneixes?",
      {"Sust", "Dada 1", "=", "Dada 2", "="},
      {"substancia", "1a magnitud coneguda", "valor, en la unitat del desplegable",
       "2a magnitud coneguda", "valor, en la unitat del desplegable"});

    IF zok == 0 THEN
      zgo := 0;
    ELSE
      IF TCUR <> zprev THEN TLOAD(TCUR); END;
      // Del desplegable a l'interior: TIDX dona el id de magnitud i TCONV
      // porta el valor a la unitat en que esta tabulada la substancia. Cal
      // fer-ho DESPRES del TLOAD, perque TCONV mira TMD.
      zi1 := TIDX(TD1); zw1 := TCONV(TD1, TV1);
      zi2 := TIDX(TD2); zw2 := TCONV(TD2, TV2);
      IF zi1 == zi2 THEN
        MSGBOX("Tria dues magnituds DIFERENTS.");
      ELSE
        // S'ordena el parell per index: tant se val en quin ordre s'hagin
        // triat les dues magnituds.
        IF zi1 > zi2 THEN
          zsw := zi1; zi1 := zi2; zi2 := zsw;
          zsw := zw1; zw1 := zw2; zw2 := zsw;
        END;

        // index: 1=P 2=T 3=x 4=v 5=u 6=h 7=s
        zst := {0,0,0,0,0,0,0,-1,"parell no suportat"};
        CASE
          IF zi1 == 1 AND zi2 == 2 THEN zst := TPT(zw1, zw2); END;
          IF zi1 == 1 AND zi2 == 3 THEN zst := TPX(zw1, zw2); END;
          IF zi1 == 2 AND zi2 == 3 THEN zst := TTX(zw1, zw2); END;
          IF zi1 == 1 AND zi2 >= 4 THEN zst := TPY(zw1, zi2-3, zw2); END;
          IF zi1 == 2 AND zi2 >= 4 THEN zst := TTY(zw1, zi2-3, zw2); END;
          DEFAULT
            zst := {0,0,0,0,0,0,0,-1,
                    "cal donar P o T amb una altra magnitud"};
        END;

        // Els dos ultims estats es desen sols, per al salt 1->2.
        IF zst(8) >= 0 THEN
          TS1 := TS2;
          TS2 := zst;
        END;

        zk := TSHOW(zst);
        // Qualsevol tecla torna al formulari (el bucle continua). Nomes
        // tres fan una altra cosa; si algun codi no fos correcte, aquella
        // tecla cauria al cas per defecte i tornaria al formulari.
        IF zk == TKHELP THEN TAJUDA(); END;
        IF zk == TKESC THEN zgo := 0; END;
        IF zk == TKVIEW THEN
          zopt := 1;
          IF CHOOSE(zopt, "TERMO", "Nou calcul", "Salt estat 1 -> 2",
                    "Ajuda", "Sortir") <> 0 THEN
            IF zopt == 2 THEN TDELTA(); END;
            IF zopt == 3 THEN TAJUDA(); END;
            IF zopt == 4 THEN zgo := 0; END;
          END;
        END;
      END;
    END;
  END;
  RETURN zst;
END;

// Comparacio rapida dels dos estats desats (proces 1 -> 2):
// dona els salts que es demanen sempre en un balanc.
EXPORT TDELTA()
BEGIN
  LOCAL zy, za, zb;
  // Es copien a locals ABANS d'indexar-les. Indexar directament una variable
  // global que el compilador no te clar que sigui una llista es llegeix com
  // una crida a funcio i no compila.
  za := TS1; zb := TS2;
  IF SIZE(za) < 9 OR SIZE(zb) < 9 THEN
    MSGBOX("Calcula DOS estats amb TERMO() i torna a provar.");
    RETURN 0;
  END;
  RECT();
  TEXTOUT_P("SALT DEL ESTAT 1 AL 2", 4, 2, 3, RGB(0,0,180));
  TEXTOUT_P("1:  T=" + TDEC(za(1),2) + "   P=" + TSIG(za(2),5) +
            "   h=" + TDEC(za(5),2), 4, 26, 2);
  TEXTOUT_P("2:  T=" + TDEC(zb(1),2) + "   P=" + TSIG(zb(2),5) +
            "   h=" + TDEC(zb(5),2), 4, 44, 2);
  zy := 68;
  TEXTOUT_P("dh = " + TDEC(zb(5)-za(5),2) + " kJ/kg", 4, zy, 3); zy := zy + 25;
  TEXTOUT_P("du = " + TDEC(zb(4)-za(4),2) + " kJ/kg", 4, zy, 3); zy := zy + 25;
  TEXTOUT_P("ds = " + TDEC(zb(6)-za(6),4) + " kJ/kgK", 4, zy, 3); zy := zy + 25;
  TEXTOUT_P("dv = " + TSIG(zb(3)-za(3),5) + " m3/kg", 4, zy, 3); zy := zy + 25;
  TEXTOUT_P("dT = " + TDEC(zb(1)-za(1),2), 4, zy, 3); zy := zy + 25;
  TEXTOUT_P("dP = " + TSIG(zb(2)-za(2),5) + " MPa", 4, zy, 3);
  TEXTOUT_P("Prem una tecla per tornar", 4, 220, 2);
  TPAUSE();
  RETURN 1;
END;

// ====== GANXOS DE LA APP (ve de ppl/APP_TAULES.hpprgm) ======
EXPORT START()
BEGIN
  TERMO();
END;

// La tecla [Num] tambe hi entra: es la mes gran i facil de trobar.
EXPORT Num()
BEGIN
  TERMO();
END;

// [Shift][Apps] mostra aquesta nota. Info() nomes admet PRINT.
EXPORT Info()
BEGIN
  LOCAL zi;
  // Recorre la MATEIXA llista que dibuixa [Help], per no tenir dos textos
  // d'ajuda que se separin amb el temps. Info() nomes admet PRINT.
  PRINT();
  PRINT("TAULES - propietats termodinamiques");
  PRINT("");
  FOR zi FROM 1 TO SIZE(TAJUT) DO
    PRINT(TAJUT(zi));
  END;
END;

// Torna a deixar-ho tot com al principi.
EXPORT RESET()
BEGIN
  TCUR := 1;
  TD1 := 1;
  TD2 := 6;
  TV1 := 0;
  TV2 := 0;
  TS1 := {};
  TS2 := {};
  TLOAD(TCUR);
END;

// No hi ha blocs VIEW a proposit. START() engega TERMO(), que es queda amb
// el teclat mentre dura, aixi que les tecles de vista no arriben mai a
// l'app: es TERMO qui les llegeix a la pantalla de resultats (qualsevol
// tecla torna al formulari, [View] obre el menu, [Help] l'ajuda, [Esc] surt).
